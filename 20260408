#include <string>
#include <vector>

using namespace std;

vector<int> solution(vector<int> arr, int divisor) {
    vector<int> answer;
    for (int i = 0; i < arr.size(); i++) {
        if (arr[i] % divisor == 0) {
            answer.push_back(arr[i]);
        }
    }

    if (answer.empty()) {
        answer.push_back(-1);
        return answer;
    }

    for (int i = 0; i < answer.size(); i++) {
        for (int j = 0; j < answer.size() - 1 - i; j++) {
            if (answer[j] > answer[j + 1]) {
               
                int temp = answer[j];
                answer[j] = answer[j + 1];
                answer[j + 1] = temp;
            }
        }
    }
    return answer;
}
